CAPI=2:

name: "x-heep:ip:spi"
description: "core-v-mini-mcu spi peripheral"

# Copyright 2026 POLITO
# Solderpad Hardware License, Version 2.1, see LICENSE.md for details.
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1

filesets:
  files_rtl:
    depend:
      - pulp-platform.org::register_interface
      - yosyshq:picorv32_spimemio:0-r1
      - lowrisc:ip:spi_host:1.0
      - x-heep:ip:w25q128jw_controller
    files:
    - rtl/spi_subsystem.sv
    file_type: systemVerilogSource

# RTL is directly vendored from OpenTitan, so we only generated headers and docs
generate:
  spi_host:
    generator: regtool
    parameters:
      config:           vendor/lowrisc_opentitan_spi_host/data/spi_host.hjson
      name:             spi_host
      sw_path:          sw/spi_host/spi_host_regs.h
      structs_sw_path:  sw/spi_host/spi_host_structs.h
      doc_path:         docs/spi_host/spi_host_regs.md

targets:
  default:
    filesets:
    - files_rtl
    generate:
    - spi_host
